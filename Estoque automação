import json
import os

ARQUIVO_ESTOQUE = "estoque_seu_joao.json"

def carregar_estoque():
    """Carrega os dados do estoque do arquivo JSON."""
    if os.path.exists(ARQUIVO_ESTOQUE):
        with open(ARQUIVO_ESTOQUE, "r", encoding="utf-8") as f:
            return json.load(f)
    return {}

def salvar_estoque(estoque):
    """Salva os dados atuais no arquivo JSON."""
    with open(ARQUIVO_ESTOQUE, "w", encoding="utf-8") as f:
        json.dump(estoque, f, ensure_ascii=False, indent=4)

def cadastrar_produto(estoque):
    nome = input("Nome do produto: ").strip().capitalize()
    if not nome:
        print("❌ O nome não pode estar vazio.")
        return
    
    if nome in estoque:
        print("⚠️ Este produto já está cadastrado!")
        return
    
    try:
        quantidade = int(input("Quantidade inicial: "))
        preco = float(input("Preço unitário (R$): "))
        estoque[nome] = {"quantidade": quantidade, "preco": preco}
        salvar_estoque(estoque)
        print(f"✅ Produto '{nome}' cadastrado com sucesso!")
    except ValueError:
        print("❌ Erro: Digite valores numéricos válidos para quantidade e preço.")

def registrar_movimentacao(estoque, tipo):
    """Controla entrada (compra) ou saída (venda) de produtos."""
    if tipo == 'entrada':
        acao = "adicionar ao"
    else:
        acao = "dar baixa no"
        
    nome = input(f"Nome do produto para {acao} estoque: ").strip().capitalize()
    
    if nome not in estoque:
        print("❌ Produto não encontrado no estoque!")
        return
    
    try:
        qtd = int(input(f"Quantidade a {'adicionar' if tipo == 'entrada' else 'retirar'}: "))
        if tipo == 'entrada':
            estoque[nome]["quantidade"] += qtd
            print(f"✅ Entrada registrada! Novo estoque de {nome}: {estoque[nome]['quantidade']}")
        elif tipo == 'saida':
            if qtd > estoque[nome]["quantidade"]:
                print("❌ Erro: Quantidade insuficiente em estoque!")
                return
            estoque[nome]["quantidade"] -= qtd
            print(f"✅ Venda registrada! Novo estoque de {nome}: {estoque[nome]['quantidade']}")
        
        salvar_estoque(estoque)
    except ValueError:
        print("❌ Erro: Digite um número válido.")

def listar_estoque(estoque):
    """Mostra todos os produtos e o valor total em mercadorias."""
    if not estoque:
        print("\n📦 O estoque está vazio.")
        return
    
    print("\n" + "="*40)
    print(f"{'PRODUTO':<15} | {'QTD':<5} | {'PREÇO (R$)':<10}")
    print("="*40)
    
    total_geral = 0
    for produto, info in estoque.items():
        subtotal = info["quantidade"] * info["preco"]
        total_geral += subtotal
        print(f"{produto:<15} | {info['quantidade']:<5} | R$ {info['preco']:<8.2f}")
    
    print("="*40)
    print(f"💰 Valor total em estoque: R$ {total_geral:.2f}\n")

def main():
    estoque = carregar_estoque()
    
    while True:
        print("\n--- CONTROLE DE ESTOQUE - SEU JOÃO ---")
        print("1. Ver Estoque")
        print("2. Cadastrar Novo Produto")
        print("3. Registrar Entrada (Compra)")
        print("4. Registrar Saída (Venda)")
        print("5. Sair")
        
        opcao = input("Escolha uma opção (1-5): ").strip()
        
        if opcao == "1":
            listar_estoque(estoque)
        elif opcao == "2":
            cadastrar_produto(estoque)
        elif opcao == "3":
            registrar_movimentacao(estoque, "entrada")
        elif opcao == "4":
            registrar_movimentacao(estoque, "saida")
        elif opcao == "5":
            print("👋 Fechando o sistema. Até logo!")
            break
        else:
            print("❌ Opção inválida! Escolha um número de 1 a 5.")

if __name__ == "__main__":
    main() 
    
    from datetime import datetime
import json
import os
import pandas as pd
import streamlit as st

ARQUIVO_ESTOQUE = "estoque_seu_joao.json"
ARQUIVO_HISTORICO = "historico_seu_joao.json"


# --- FUNÇÕES DE DADOS ---
def carregar_dados(arquivo, padrao):
  if os.path.exists(arquivo):
    with open(arquivo, "r", encoding="utf-8") as f:
      return json.load(f)
  return padrao


def salvar_dados(arquivo, dados):
  with open(arquivo, "w", encoding="utf-8") as f:
    json.dump(dados, f, ensure_ascii=False, indent=4)


# Carrega dados
estoque = carregar_dados(ARQUIVO_ESTOQUE, {})
historico = carregar_dados(ARQUIVO_HISTORICO, [])

# --- INTERFACE DO APLICATIVO (VISUAL WEB) ---
st.title("🛒 Controle de Estoque - Seu João")
st.write("Gerencie os produtos, visualize gráficos e acompanhe as datas!")

# Menu lateral
menu = st.sidebar.selectbox(
    "Navegação",
    ["Painel Principal", "Cadastrar Produto", "Entrada/Saída", "Histórico"],
)

# 1. PAINEL PRINCIPAL (Gráficos e Visão Geral)
if menu == "Painel Principal":
  st.header("📊 Visão Geral do Estoque")

  if not estoque:
    st.info("Nenhum produto cadastrado ainda. Vá na aba lateral para cadastrar!")
  else:
    # Prepara dados para tabela e gráficos
    dados_tabela = []
    for prod, info in estoque.items():
      dados_tabela.append({
          "Produto": prod,
          "Quantidade": info["quantidade"],
          "Preço (R$)": info["preco"],
          "Valor Total (R$)": info["quantidade"] * info["preco"],
      })

    df = pd.DataFrame(dados_tabela)

    # Métricas rápidas
    total_itens = df["Quantidade"].sum()
    valor_geral = df["Valor Total (R$)"].sum()

    col1, col2 = st.columns(2)
    col1.metric("📦 Total de Itens em Estoque", total_itens)
    col2.metric("💰 Valor Total Investido", f"R$ {valor_geral:.2f}")

    st.subheader("Tabela de Produtos")
    st.dataframe(df, use_container_width=True)

    # Gráfico gerado automaticamente
    st.subheader("📈 Gráfico de Quantidade por Produto")
    st.bar_chart(df.set_index("Produto")["Quantidade"])

# 2. CADASTRAR PRODUTO
elif menu == "Cadastrar Produto":
  st.header("➕ Cadastrar Novo Produto")

  with st.form("form_cadastro"):
    nome = st.text_input("Nome do Produto").strip().capitalize()
    quantidade = st.number_input(
        "Quantidade Inicial", min_value=0, step=1, format="%d"
    )
    preco = st.number_input(
        "Preço Unitário (R$)", min_value=0.0, format="%.2f"
    )
    enviar = st.form_submit_button("Salvar Produto")

    if enviar:
      if not nome:
        st.warning("⚠️ O nome do produto não pode estar vazio.")
      elif nome in estoque:
        st.warning(f"⚠️ O produto '{nome}' já existe no estoque!")
      else:
        estoque[nome] = {"quantidade": int(quantidade), "preco": float(preco)}
        salvar_dados(ARQUIVO_ESTOQUE, estoque)

        # Registra no histórico com data e hora
        data_atual = datetime.now().strftime("%d/%m/%Y %H:%M")
        historico.append({
            "data": data_atual,
            "produto": nome,
            "tipo": "Cadastro Inicial",
            "qtd": int(quantidade),
        })
        salvar_dados(ARQUIVO_HISTORICO, historico)

        st.success(f"✅ Produto '{nome}' cadastrado com sucesso!")

# 3. ENTRADA E SAÍDA DE PRODUTOS
elif menu == "Entrada/Saída":
  st.header("🔄 Movimentação de Estoque")

  if not estoque:
    st.warning("Cadastre algum produto primeiro!")
  else:
    tipo_mov = st.selectbox(
        "Tipo de Movimentação", ["Entrada (Compra)", "Saída (Venda)"]
    )
    produto_escolhido = st.selectbox("Selecione o Produto", list(estoque.keys()))
    qtd_mov = st.number_input(
        "Quantidade", min_value=1, step=1, format="%d"
    )

    if st.button("Confirmar Movimentação"):
      data_atual = datetime.now().strftime("%d/%m/%Y %H:%M")

      if tipo_mov == "Entrada (Compra)":
        estoque[produto_escolhido]["quantidade"] += int(qtd_mov)
        historico.append({
            "data": data_atual,
            "produto": produto_escolhido,
            "tipo": "Entrada",
            "qtd": int(qtd_mov),
        })
        st.success(
            f"✅ Entrada registrada! Novo estoque de {produto_escolhido}:"
            f" {estoque[produto_escolhido]['quantidade']}"
        )
      else:
        estoque_atual = estoque[produto_escolhido]["quantidade"]
        if qtd_mov > estoque_atual:
          st.error(
              f"❌ Erro: Estoque insuficiente! Só há {estoque_atual} unidades"
              " disponíveis."
          )
        else:
          estoque[produto_escolhido]["quantidade"] -= int(qtd_mov)
          historico.append({
              "data": data_atual,
              "produto": produto_escolhido,
              "tipo": "Saída (Venda)",
              "qtd": int(qtd_mov),
          })
          st.success(
              f"✅ Venda registrada! Novo estoque de {produto_escolhido}:"
              f" {estoque[produto_escolhido]['quantidade']}"
          )

      salvar_dados(ARQUIVO_ESTOQUE, estoque)
       salvar_dados(ARQUIVO_HISTORICO, historico)

# 4. HISTÓRICO COM DATAS
elif menu == "Histórico":
  st.header("📅 Histórico de Movimentações")

  if not historico:
    st.info("Nenhuma movimentação registrada ainda.")
  else:
    df_hist = pd.DataFrame(historico)
    st.dataframe(df_hist, use_container_width=True)



